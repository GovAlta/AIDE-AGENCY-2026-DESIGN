{
  "name": "aide-agency-2026-design",
  "version": "1.0.0",
  "private": true,
  "description": "Agency 2026 design system: tokens, fonts, styles, templates and scripts for print, slides, digital and video (MVAI).",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "vectors": "node scripts/vectors.mjs all",
    "samples": "node scripts/make.mjs --all",
    "sheets": "node scripts/contact-sheets.mjs",
    "build": "npm run tokens && npm run vectors && npm run samples && node scripts/motion-render.mjs --all && npm run sheets",
    "check": "node scripts/make.mjs --all --check",
    "motion": "node scripts/motion-render.mjs --all",
    "show": "node show/server.mjs",
    "show:test": "node show/test/run.mjs && node show/test/remote.mjs && node show/test/voice.mjs",
    "a11y": "node scripts/a11y/contrast.mjs",
    "print-ready": "node scripts/print-export.mjs",
    "ci": "node scripts/make.mjs --all --check && node scripts/ci/qr-samples.mjs",
    "voice:check": "python3 scripts/voice/say.py --agenda show/samples/agency-2026.json --check",
    "studio": "node app/server.mjs",
    "show:pack": "node show/pack.mjs",
    "displays": "bash displays/make-examples.sh",
    "display": "node displays/build.mjs",
    "film:new": "node showcase/kit/tools/new-film.mjs",
    "film:check": "node showcase/kit/tools/contrast.mjs && node showcase/kit/tools/sync-tokens.mjs",
    "film:install": "npm --prefix showcase/kit ci"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "playwright": "1.62.0",
    "pngjs": "^7.0.0",
    "qrcode": "1.5.4"
  }
}